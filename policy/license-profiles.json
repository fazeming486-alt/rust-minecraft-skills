{
  "schema_version": "0.1.0",
  "version": "0.2.0",
  "note": "方案 C 的唯一规则源，v0.2 按 ADR 0008 改为三维度正交模型。inspection 决定能否读，transformation 决定能否转（technical-only = 语义不变的格式等价转换），distribution 决定能否分发。ND 限制的是分享改编版与商用，不是本地技术性转换。工程政策判断，非法律意见。",
  "dimensions": {
    "inspection": ["full-inspection", "metadata-only", "oracle-only"],
    "transformation": ["technical-only", "creative", "port", "none"],
    "distribution": ["local-only", "redistributable"]
  },
  "mode_profiles": {
    "full-inspection": {"inspection": "full", "transformation": "technical-only", "distribution": "local-only"},
    "metadata-only": {"inspection": "signature", "transformation": "none", "distribution": "local-only"},
    "oracle-only": {"inspection": "none", "transformation": "none", "distribution": "local-only"}
  },
  "default_mode": "oracle-only",
  "default_transformation": "none",
  "default_distribution": "local-only",
  "default_redistribution": false,
  "severity": {"full-inspection": 0, "metadata-only": 1, "oracle-only": 2},
  "scopes": ["code", "assets"],
  "split_tokens": ["/", ";", "|", " and ", " & ", ","],
  "global_forbidden_actions": [
    "creative_adaptation",
    "publish_adapted_material",
    "commercial_use",
    "communicate_with_other_subagents",
    "self_assess_complexity"
  ],
  "modes": {
    "full-inspection": {
      "summary": "可读源码正文、class 常量池，以及 mod 自己的数据文件与二进制资产（用于技术性转换）",
      "allowed_actions": ["read_source_text", "read_class_constant_pool", "extract_string_literals", "extract_annotation_values", "extract_method_names", "extract_type_signatures", "read_jar_metadata", "list_resource_entries", "read_public_docs", "read_own_data_files", "observe_behaviour", "read_asset_data_file", "read_binary_asset", "technical_format_conversion"],
      "forbidden_actions": ["creative_adaptation", "publish_adapted_material", "commercial_use"],
      "output_fields": ["annotations", "superclasses", "interfaces", "import_prefixes", "referenced_types", "constant_strings", "methods", "declared_kind"]
    },
    "metadata-only": {
      "summary": "签名级：类 FQN / 注解类型名 / 父类 / 接口 / 声明类型；不做内容转换",
      "allowed_actions": ["read_jar_metadata", "list_resource_entries", "extract_type_signatures", "extract_annotation_type_names", "extract_declared_kind", "read_public_docs", "read_own_data_files", "observe_behaviour"],
      "forbidden_actions": ["read_source_text", "read_method_bodies", "extract_string_literals", "extract_annotation_values", "extract_method_names", "creative_adaptation", "publish_adapted_material", "commercial_use"],
      "output_fields": ["annotations", "superclasses", "interfaces", "import_prefixes", "referenced_types", "declared_kind"]
    },
    "oracle-only": {
      "summary": "仅行为观测、公开文档与自有数据文件；不读内容、不转换",
      "allowed_actions": ["observe_behaviour", "read_public_docs", "read_own_data_files", "list_resource_entries"],
      "forbidden_actions": ["read_source_text", "read_class_constant_pool", "extract_type_signatures", "extract_annotation_type_names", "extract_string_literals", "extract_annotation_values", "extract_method_names", "technical_format_conversion", "creative_adaptation", "publish_adapted_material", "commercial_use"],
      "output_fields": []
    }
  },
  "license_patterns": [
    {
      "id": "permissive-code",
      "priority": 10,
      "match_any": ["mit", "apache-2", "apache 2", "apache", "bsd", "cc0", "cc-by", "unlicense", "isc", "zlib", "public domain", "mpl-2"],
      "exclude_any": ["nc", "nd", "non-commercial", "no derivatives", "no-deriv"],
      "scope": "code",
      "mode": "full-inspection",
      "transformation": "port",
      "distribution": "redistributable",
      "redistribution": true,
      "note": "宽松许可：可完整分析并移植；发布衍生需保留版权声明"
    },
    {
      "id": "copyleft-code",
      "priority": 20,
      "match_any": ["gpl", "lgpl", "agpl", "mpl", "epl", "cddl", "copyleft"],
      "exclude_any": [],
      "scope": "code",
      "mode": "full-inspection",
      "transformation": "port",
      "distribution": "local-only",
      "redistribution": false,
      "note": "本地研究与重写可行；发布衍生需同协议开源并公布源码"
    },
    {
      "id": "no-derivatives-assets",
      "priority": 5,
      "match_any": ["cc by-nc-nd", "cc-by-nc-nd", "cc by nc nd", "no derivatives", "no-derivatives", "no-deriv", "all rights reserved", "arr", "proprietary"],
      "exclude_any": [],
      "scope": "assets",
      "mode": "full-inspection",
      "transformation": "technical-only",
      "distribution": "local-only",
      "redistribution": false,
      "note": "ADR 0008 修正：ND 只禁止分享/商用改编版；本地语义不变的格式等价转换可行，产物只留 work/。重绘/改造/发布需授权"
    },
    {
      "id": "noncommercial-assets",
      "priority": 15,
      "match_any": ["non-commercial", "noncommercial", "cc by-nc", "cc-by-nc", " by-nc", "-nc "],
      "exclude_any": ["nd"],
      "scope": "assets",
      "mode": "full-inspection",
      "transformation": "technical-only",
      "distribution": "local-only",
      "redistribution": false,
      "note": "NC 只限制商用；本地技术性转换可行，不得发布或商用"
    },
    {
      "id": "unknown-or-custom",
      "priority": 90,
      "match_any": ["unknown", "unspecified", "unlicensed", "custom", "see ", "contact", "ask ", "none"],
      "exclude_any": [],
      "scope": "code",
      "mode": "oracle-only",
      "transformation": "none",
      "distribution": "local-only",
      "redistribution": false,
      "note": "无法判定，强制人工复核；不读内容、不转换"
    }
  ],
  "scope_hints": {
    "code": [".java", ".class", "src/", "com/", "net/", "org/"],
    "assets": ["assets/", "textures", "models", "sounds", "lang/", ".png", ".ogg", ".wav", ".bbmodel", ".gltf", ".obj", ".fbx"]
  },
  "distribution_conditions": {
    "local-only": [
      "产物只留在 work/ 等被 .gitignore 排除的目录",
      "不发布、不上传、不进入任何 mod index / launcher browser / 发布链",
      "不用于商业目的",
      "不做创造性改编（重绘、改模型造型、改写动画表现）",
      "若要发布，须先取得权利人书面授权或换成自有/宽松许可资产"
    ]
  },
  "decision_precedence": [
    "explicit_user_override",
    "license_pattern_by_priority",
    "scope_specific_combination",
    "default_deny"
  ],
  "review_triggers": [
    "任何许可证段未匹配规则",
    "同一 scope 出现互斥判定",
    "license_raw 缺失或为空",
    "转换是否属于 technical-only 无法判定",
    "用户覆盖规则时",
    "任何发布、商用或贡献上游的计划"
  ]
}
