{
  "schema_version": "0.1.0",
  "template_id": "m2",
  "version": "0.2.0",
  "milestone": "M2 · 美术链与 animation_driver 缺口",
  "note": "v0.7 执行版。ADR 0008 三维度政策已落地：资产任务从路径级清单升级为真实技术性格式等价转换；新增目标侧 Horizon 源码研读三路（分 skill 派发）与跨层特性切片，专门处理「动画 = 美术资产 + Java 状态机 + 目标侧 hook + 同步契约」的复合体。产物只留 work/，不发布、不商用、不重绘。",
  "compliance": {
    "transformation": "technical-only",
    "distribution": "local-only",
    "forbidden_actions": ["creative_adaptation", "publish_adapted_material", "commercial_use"],
    "distribution_conditions": [
      "产物只留在 work/ 等被 .gitignore 排除的目录",
      "不发布、不上传、不进入任何发布链",
      "不用于商业目的",
      "不做创造性改编（重绘、改模型造型、改写动画表现）"
    ]
  },
  "tasks": [
    {
      "id": "m2-01-inventory",
      "role": "art-inventory",
      "goal": "产出资产清单与各族规模统计，作为转换输入基线",
      "inputs": ["jar:assets/**", "jar:data/**"],
      "policy_mode": "full-inspection",
      "output_contract": "report:art-inventory",
      "acceptance": ["按扩展名与目录精确计数", "仓库内报告只含统计", "清单闭合可复核"],
      "depends_on": [],
      "priority": 10
    },
    {
      "id": "m2-02-geometry",
      "role": "geometry-asset",
      "goal": "332 个 Bedrock geometry 转 bone IR，验证可逆并标注目标侧无消费者",
      "inputs": ["jar:**/geo_models/**", "reports/horizon-asset-schema.json"],
      "policy_mode": "full-inspection",
      "output_contract": "conversion:geometry-ir",
      "acceptance": ["roundtrip 闭合", "schema_status 为 unbound 且理由明确", "产物只留 work/"],
      "depends_on": ["m2-01-inventory", "m2-14-target-assets"],
      "priority": 30
    },
    {
      "id": "m2-03-animation",
      "role": "animation-asset",
      "goal": "157 个动画状态参数化压缩 + 骨骼轨道按状态重组，均验证可逆",
      "inputs": ["jar:**/animations/**", "orchestration/slice-anchors.json"],
      "policy_mode": "full-inspection",
      "output_contract": "conversion:animation-states",
      "acceptance": ["状态 roundtrip 闭合且未匹配为 0", "骨骼轨道可逆", "无消费者部分标 unbound"],
      "depends_on": ["m2-01-inventory"],
      "priority": 30
    },
    {
      "id": "m2-04-texture",
      "role": "texture-asset",
      "goal": "1079 个 PNG 原样搬运，sha256 前后一致",
      "inputs": ["jar:**/textures/**"],
      "policy_mode": "full-inspection",
      "output_contract": "conversion:texture-carry",
      "acceptance": ["sha256 全部一致", "不重绘、不重编码", "产物只留 work/"],
      "depends_on": ["m2-01-inventory"],
      "priority": 30
    },
    {
      "id": "m2-05-audio",
      "role": "audio-asset",
      "goal": "1712 个 OGG 原样搬运 + sounds.json 事件表映射口径",
      "inputs": ["jar:**/sounds/**", "jar:**/tacz_sounds/**", "jar:assets/tacz/sounds.json"],
      "policy_mode": "full-inspection",
      "output_contract": "conversion:audio-carry",
      "acceptance": ["sha256 全部一致", "事件表映射口径可查", "不发布"],
      "depends_on": ["m2-01-inventory"],
      "priority": 30
    },
    {
      "id": "m2-06-display-index",
      "role": "display-index",
      "goal": "236 display / 232 index / 42 lang 路径重写为 .hmod assets 布局，键集合守恒",
      "inputs": ["jar:**/display/**", "jar:data/*/index/**", "jar:**/lang/**"],
      "policy_mode": "full-inspection",
      "output_contract": "conversion:namespace-rewrite",
      "acceptance": ["JSON 键集合守恒", "明确 assets 侧与 data 侧不 1:1", "产物只留 work/"],
      "depends_on": ["m2-01-inventory", "m2-14-target-assets"],
      "priority": 30
    },
    {
      "id": "m2-07-data-registry",
      "role": "data-registry",
      "goal": "内容包数据 JSON 到 26.3 数据格式的差异清单与命名空间冲突检查",
      "inputs": ["jar:data/**", "horizon:docs/api/content.md"],
      "policy_mode": "full-inspection",
      "output_contract": "mapping:data-registry",
      "acceptance": ["格式差异清单", "命名空间冲突检查", "转换可逆"],
      "depends_on": ["m2-01-inventory", "m2-15-target-mod-api"],
      "priority": 30
    },
    {
      "id": "m2-08-loc-shader",
      "role": "localization-shader",
      "goal": "42 lang / 13 shader / 66 lua / 7 gui 的目标侧支持性分类",
      "inputs": ["jar:**/lang/**", "jar:**/shaders/**", "jar:**/*.lua"],
      "policy_mode": "full-inspection",
      "output_contract": "report:loc-shader",
      "acceptance": ["明确不支持类别", "不假设 lua 可运行", "不复制脚本内容"],
      "depends_on": ["m2-01-inventory"],
      "priority": 40
    },
    {
      "id": "m2-09-animation-gap",
      "role": "animation-gap",
      "goal": "基于 Rust 源码事实复核 animation_driver 硬缺口与两阶段渲染路径",
      "inputs": ["horizon:native-hooks.json", "target/horizon.capabilities.json", "reports/horizon-render-pipeline.json", "reports/horizon-mod-api.json"],
      "policy_mode": "full-inspection",
      "output_contract": "report:animation-gap",
      "acceptance": ["区分硬缺口与 workaround", "结论附 Horizon 源码路径或行号", "不把近似写成已支持"],
      "depends_on": ["m2-13-target-render", "m2-15-target-mod-api"],
      "priority": 20
    },
    {
      "id": "m2-10-contract-alignment",
      "role": "contract-alignment",
      "goal": "逐切片核对 shared_states、authority 与 sync_boundary，输出契约复核清单",
      "inputs": ["work/feature-slices.json", "schemas/manifest.schema.json"],
      "policy_mode": "full-inspection",
      "output_contract": "review:contract-alignment",
      "acceptance": ["状态枚举双向可查", "每个 slice 的 authority 与 sync_boundary 明确", "不一致即判失败"],
      "depends_on": ["m2-16-feature-slices", "m2-03-animation"],
      "priority": 50
    },
    {
      "id": "m2-11-policy-compliance",
      "role": "policy-compliance",
      "goal": "审查所有任务包与 result 的三维边界",
      "inputs": ["work/dispatch/**", "policy/**", "reports/m2-conversion.json"],
      "policy_mode": "full-inspection",
      "output_contract": "review:policy-compliance",
      "acceptance": ["distribution 为 local-only 且禁止发布/商用/创造性改编", "转换产物不得出现在可入库目录", "越界即整体中止"],
      "depends_on": [],
      "priority": 5
    },
    {
      "id": "m2-12-verification",
      "role": "verification",
      "goal": "汇总结果、检查清单闭合并生成 M2 验收清单",
      "inputs": ["work/dispatch/**", "reports/**"],
      "policy_mode": "full-inspection",
      "output_contract": "report:verification",
      "acceptance": ["每个任务有 result 或阻塞原因", "缺口清单闭合", "verdict 可复核"],
      "depends_on": ["m2-10-contract-alignment", "m2-11-policy-compliance", "m2-17-conversion"],
      "priority": 90
    },
    {
      "id": "m2-13-target-render",
      "role": "target-study-render",
      "goal": "研读 Horizon 客户端渲染 / 手部 / 逐部件姿态管线，产出可回归源码事实",
      "inputs": ["horizon:crates/horizon-client/src/game/native_hooks.rs", "horizon:crates/horizon-client-render/src/models.rs", "orchestration/horizon-probes/render-pipeline.json"],
      "policy_mode": "full-inspection",
      "output_contract": "facts:horizon-render-pipeline",
      "acceptance": ["探针 missing_files 为空", "骨骼/glTF/Bedrock 缺席由 tree_scan 证明", "报告不含源码正文"],
      "depends_on": [],
      "priority": 10
    },
    {
      "id": "m2-14-target-assets",
      "role": "target-study-assets",
      "goal": "研读 Horizon 资产模型 / 动画元数据 / item model 条件系统，产出可回归源码事实",
      "inputs": ["horizon:crates/horizon-assets/src/animation.rs", "horizon:crates/horizon-assets/src/item_model.rs", "orchestration/horizon-probes/asset-schema.json"],
      "policy_mode": "full-inspection",
      "output_contract": "facts:horizon-asset-schema",
      "acceptance": ["AnimationClip 判定为贴图精灵帧动画且有行号", "foreign.rs 静默降级有行号证据", "报告不含源码正文"],
      "depends_on": [],
      "priority": 10
    },
    {
      "id": "m2-15-target-mod-api",
      "role": "target-study-mod-api",
      "goal": "研读 mod API 生成 / hook 分发 / tier 归属 / .hmod 加载链与 harness 现状",
      "inputs": ["horizon:crates/horizon-mod-api-gen/src/lib.rs", "horizon:crates/horizon-mods/src/manifest.rs", "horizon:crates/horizon-port-pack/src/oracle.rs", "orchestration/horizon-probes/mod-api.json"],
      "policy_mode": "full-inspection",
      "output_contract": "facts:horizon-mod-api",
      "acceptance": ["证明 mod_api 无 tier 字段", "0.5 仅声明未实现有行号", "oracle / coverage 实现存在"],
      "depends_on": [],
      "priority": 10
    },
    {
      "id": "m2-16-feature-slices",
      "role": "cross-layer-slice",
      "goal": "把动画这类跨层特性缝成资产/代码/目标/契约四层切片并判定 verdict",
      "inputs": ["jar:**/*.animation.json", "work/index.source.json", "work/delta.source.json", "orchestration/slice-anchors.json", "target/horizon.capabilities.json"],
      "policy_mode": "full-inspection",
      "output_contract": "slice:feature-slices",
      "acceptance": ["每个切片四层齐全", "shared_states 是唯一状态来源", "unmatched 为 0 且 roundtrip 闭合", "硬缺口不得伪装成 portable"],
      "depends_on": ["m2-01-inventory", "m2-13-target-render", "m2-14-target-assets", "m2-15-target-mod-api"],
      "priority": 25
    },
    {
      "id": "m2-17-conversion",
      "role": "asset-conversion",
      "goal": "执行五个技术性格式等价转换器并做 roundtrip 验证，产出脱敏统计",
      "inputs": ["jar:assets/**", "jar:data/**", "work/policy-decision.json", "work/feature-slices.json"],
      "policy_mode": "full-inspection",
      "output_contract": "conversion:m2-conversion-report",
      "acceptance": ["所有转换器 roundtrip_closed 为 true", "产物只留 work/", "仓库内只放脱敏统计报告"],
      "depends_on": ["m2-16-feature-slices", "m2-02-geometry", "m2-03-animation", "m2-04-texture", "m2-05-audio", "m2-06-display-index"],
      "priority": 60
    }
  ]
}
