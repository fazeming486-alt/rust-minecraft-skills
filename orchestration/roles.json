    {
      "id": "verification",
      "summary": "汇总各子 agent 结果、检查闭合与生成验收清单",
      "allowed_skills": ["collect-results", "diff-test-harness"],
      "allowed_actions": ["read_own_data_files", "list_resource_entries"],
      "input_globs": ["work/dispatch/**", "reports/**"],
      "output_kind": "report",
