      "allowed_skills": ["policy-gate", "validate"],
      "allowed_actions": ["read_jar_metadata", "list_resource_entries", "read_own_data_files"],
      "input_globs": ["work/m4/*.policy.json", "work/policy-decision.json", "policy/license-profiles.json"],
      "output_kind": "review",
