      "allowed_skills": ["diff-test-harness", "collect-results"],
      "allowed_actions": ["read_own_data_files", "list_resource_entries"],
      "input_globs": ["tests/fixtures/*.json", "reports/m2-conversion.json", "reports/m2-feature-slices.json"],
      "output_kind": "verification",
      "can_parallel": true,
      "acceptance": ["PASS 用例全绿", "FAIL 用例必须抓到失配且可定位", "result.json 形状符合 report.rs 消费规则"]
    },
    {
      "id": "harness-probe",
      "summary": "重跑目标侧源码探针并核对 harness 契约字段",
      "allowed_skills": ["study-horizon-mod-api"],
      "allowed_actions": ["read_horizon_source", "read_own_data_files", "read_public_docs"],
      "input_globs": ["third_party/horizon/crates/horizon-port-pack/**", "mappings/harness-contract.json"],
      "output_kind": "facts",
      "can_parallel": true,
